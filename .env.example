# Shiprocket API user (Shiprocket > Settings > API > Add new API user; not your main login)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Shared dashboard password and a long random string for signing the login cookie
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Google Sheet with the Disposition column (the sheet must be shared with the service account email)
SHEET_ID=
SHEET_TAB=Cod_order_confirmation
# Locally: path to the service account key file. On Railway: paste the whole JSON into GOOGLE_SERVICE_ACCOUNT_JSON instead.
GOOGLE_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Orders whose product amount is below this (rupees) are hidden
MIN_AMOUNT=500

# NimbusPost (second shipping platform). NIMBUS_WAREHOUSE is optional: the name of your pickup address in Nimbus.
# If empty, the Shiprocket pickup location name is used.
NIMBUS_EMAIL=
NIMBUS_PASSWORD=
NIMBUS_WAREHOUSE=
